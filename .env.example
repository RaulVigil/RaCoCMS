# ========================================
# RaCo CMS — Variables de Entorno
# Copiar a .env y ajustar valores
# ========================================

# --- Base de Datos (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=raco_cms

# --- Autenticación (JWT) ---
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# --- IA (Gemini) ---
GEMINI_API_KEY=tu_api_key_de_gemini

# --- Redis (Colas y Caché) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Puertos de las Apps ---
API_PORT=3000
ADMIN_PORT=5173
FRONT_PORT=4321

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
